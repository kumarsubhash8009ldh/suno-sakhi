{
  "database": {
    "rules": "database.rules.json"
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "**/*.apk"
    ],
    "headers": [
      {
        "source": "/index.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      }
    ],
    "redirects": [
      {
        "source": "/download",
        "destination": "https://raw.githubusercontent.com/kumarsubhash8009ldh/suno-sakhi/main/Suno-Sakhi.apk?v=1.3.9-rtdb",
        "type": 302
      },
      {
        "source": "/Suno-Sakhi.apk",
        "destination": "https://raw.githubusercontent.com/kumarsubhash8009ldh/suno-sakhi/main/Suno-Sakhi.apk?v=1.3.9-rtdb",
        "type": 302
      },
      {
        "source": "/suno-sakhi.apk",
        "destination": "https://raw.githubusercontent.com/kumarsubhash8009ldh/suno-sakhi/main/Suno-Sakhi.apk?v=1.3.9-rtdb",
        "type": 302
      }
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}